# ── LLM backend ───────────────────────────────────────────────────────────
# Which provider the four agents talk to. Every option below speaks the
# OpenAI chat-completions protocol, so switching is a config change only.
#
#   groq       open-weight models, generous free tier   <- recommended for hosting
#   openai     proprietary GPT models (paid)
#   together   open-weight models (paid, no free tier)
#   openrouter mixed catalogue, some free models
#   ollama     fully local models, needs Ollama running
LLM_PROVIDER=groq

# Set the key for whichever provider you chose (ollama needs none).
GROQ_API_KEY=gsk_your_key_here
# OPENAI_API_KEY=sk-...
# TOGETHER_API_KEY=...
# OPENROUTER_API_KEY=...

# Optional: override the model. Defaults per provider are in config/models.py.
# LLM_MODEL=openai/gpt-oss-120b
# Optional: per-node overrides, e.g. a cheaper model for the simpler nodes.
# LLM_MODEL_FATIGUE_ANALYST=openai/gpt-oss-20b
#
# OpenAI reasoning models (GPT-5 family, o-series) work too, e.g.
# LLM_MODEL=gpt-5.4. Temperature is left out for them automatically (they
# reject it); optionally tune thinking time:
# LLM_REASONING_EFFORT=low          # none | minimal | low | medium | high
#   (any level but "none" uses the Responses API: Chat Completions rejects
#    tool calls combined with a reasoning effort on newer GPT-5 models)

# ── Public demo guards (hosted deploys) ───────────────────────────────────
# DEMO_MODE=true gives each visitor a private copy of the demo athletes and
# caps model runs per browser session. Leave unset when running locally.
# DEMO_MODE=true
# MAX_AI_RUNS_PER_SESSION=5
#
# Groq deprecated llama-3.3-70b-versatile and llama-3.1-8b-instant in June 2026.
# Current open-weight options: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.6-27b. Run `python -m scripts.list_models` to see what your key
# actually has access to.

# ── Embeddings ────────────────────────────────────────────────────────────
# 'local' runs BAAI/bge-base-en-v1.5 in-process via fastembed (ONNX): free,
# offline, no API key. 'openai' uses text-embedding-3-small (paid, but only
# ~$0.005 per full re-ingest — embeddings are a rounding error next to the LLM).
#
# Measured on the 14-case critic eval with the LLM held constant:
#   openai text-embedding-3-small  accuracy 1.00
#   local  bge-base-en-v1.5        accuracy 0.90   <- default
#   local  bge-small-en-v1.5       accuracy 0.80
# False-pass rate was 0.00 in all three, so a weaker backend costs recall on
# soft judgements, never safety.
#
# Changing this REQUIRES re-running: python -m rag.ingest
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── Tracing (optional) ────────────────────────────────────────────────────
# Leave blank to disable Langfuse tracing entirely.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
